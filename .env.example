# Copie para .env. Tudo aqui é opcional, exceto ADMIN_PASSWORD no primeiro start.

ADMIN_EMAIL=admin@pague.local
ADMIN_PASSWORD=troque-esta-senha
# dados fictícios [DEMO]; use false em produção
SEED_DEMO=true
TZ=America/Bahia
# true atrás de HTTPS
COOKIE_SECURE=false
# true atrás de proxy reverso (X-Forwarded-*)
TRUST_PROXY=false
MAX_UPLOAD_MB=20
WORKERS=2
# >0: valores acima vão para revisão humana
AUTO_APPROVE_MAX=0

# Integrações externas NÃO enviam nada enquanto isto for true (mensagens ficam como "simuladas").
INTEGRATIONS_DRY_RUN=true

# IA (opcional; sem chave a leitura usa regras + linha digitável)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Caixa de faturas (IMAP sobre TLS, host:porta)
IMAP_ADDR=
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# Whatc: gateway de WhatsApp/ocorrências (caminhos ajustáveis ao contrato da API)
WHATC_URL=
WHATC_TOKEN=
WHATC_MESSAGE_PATH=/api/messages
WHATC_TICKET_PATH=
WHATC_GROUPS=financeiro=ID_DO_GRUPO_NO_WHATC

# E-mail e webhook de saída
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=pague@empresa.com.br
WEBHOOK_URL=
